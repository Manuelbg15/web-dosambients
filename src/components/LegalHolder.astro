---
// Datos del titular para las páginas legales (fuente: src/data/site.ts → legal).
import { site } from '../data/site';
const { legal } = site;
---

<ul>
  <li><strong>Titular:</strong> {legal.companyName} (nombre comercial: {site.name})</li>
  <li><strong>CIF:</strong> {legal.cif}</li>
  <li><strong>Domicilio social:</strong> {legal.registeredOffice}</li>
  <li><strong>Teléfono:</strong> {site.phone}</li>
  <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>
  {legal.registry && <li><strong>Datos registrales:</strong> {legal.registry}</li>}
</ul>

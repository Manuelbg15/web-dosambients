---
// Galería de imágenes con filtro opcional por categoría y visor (lightbox) en JS nativo.
import Icon from './Icon.astro';

interface Item {
  id: string;
  src: string;
  thumb: string;
  alt: string;
  title?: string;
  text?: string;
  category?: string;
  /** Si existe, el elemento es un vídeo (el thumb se usa como portada) */
  video?: string;
}
interface Props {
  items: Item[];
  filters?: { id: string; label: string }[];
  limit?: number;
}
const { items, filters = [], limit } = Astro.props;
const shown = limit ? items.slice(0, limit) : items;
---

<div class="gallery" data-gallery>
  {
    filters.length > 0 && (
      <div class="mb-12 flex flex-wrap justify-center gap-3" role="group" aria-label="Filtrar por categoría">
        <button type="button" data-filter="" aria-pressed="true" class="filter-btn">Todo</button>
        {filters.map((f) => (
          <button type="button" data-filter={f.id} aria-pressed="false" class="filter-btn">
            {f.label}
          </button>
        ))}
      </div>
    )
  }

  <ul class="columns-2 gap-3 md:columns-3 md:gap-5 lg:columns-4">
    {
      shown.map((item, i) => (
        <li data-category={item.category ?? ''} class="mb-3 break-inside-avoid md:mb-5" data-reveal="zoom" style={`--d:${(i % 8) * 70}`}>
          <a
            href={item.src}
            data-index={i}
            data-caption={[item.title, item.text].filter(Boolean).join(' · ')}
            data-video={item.video ? '' : undefined}
            data-alt={item.alt}
            class="group relative block overflow-hidden rounded-2xl bg-cream"
          >
            {item.video ? (
              <>
                <video
                  src={item.video}
                  poster={item.thumb}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-label={item.alt}
                  data-hover-video
                  class="w-full transition-transform duration-[1.2s] ease-out group-hover:scale-110"
                />
                <span class="absolute top-4 left-4 flex items-center gap-2 rounded-full bg-ink/70 px-3 py-1.5 text-[0.65rem] font-semibold tracking-[0.2em] text-white uppercase backdrop-blur" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3"><path d="M8 5v14l11-7z" /></svg> Vídeo
                </span>
              </>
            ) : (
              <img
                src={item.thumb}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                class="w-full transition-transform duration-[1.2s] ease-out group-hover:scale-110"
              />
            )}
            <span class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100" />
            <span class="absolute top-4 right-4 flex h-10 w-10 scale-50 items-center justify-center rounded-full bg-white text-brand-500 opacity-0 transition-all duration-500 group-hover:scale-100 group-hover:opacity-100">
              <Icon name="arrow" class="h-4 w-4 -rotate-45" />
            </span>
            {item.title && (
              <span class="absolute inset-x-0 bottom-0 translate-y-4 p-4 text-white opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
                {item.text && <span class="block text-[0.65rem] font-semibold tracking-[0.2em] text-brand-200 uppercase">{item.text}</span>}
                <span class="mt-1 block font-display text-lg font-bold uppercase">{item.title}</span>
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-ink/95 backdrop:backdrop-blur-sm" aria-label="Visor de imágenes">
    <figure class="flex h-screen w-screen flex-col items-center justify-center p-4">
      <img alt="" class="max-h-[85vh] max-w-full rounded object-contain" data-lb-img />
      <video class="hidden max-h-[85vh] max-w-full rounded" controls muted playsinline data-lb-video></video>
      <figcaption class="mt-3 text-center text-white" data-lb-caption></figcaption>
    </figure>
    <button type="button" data-lb-close class="absolute top-4 right-4 rounded-full bg-white/10 p-2 text-white hover:bg-white/25" aria-label="Cerrar">
      <Icon name="close" class="h-7 w-7" />
    </button>
    <button type="button" data-lb-prev class="absolute top-1/2 left-2 -translate-y-1/2 rounded-full bg-white/10 p-2 text-white hover:bg-white/25 md:left-6" aria-label="Anterior">
      <Icon name="left" class="h-7 w-7" />
    </button>
    <button type="button" data-lb-next class="absolute top-1/2 right-2 -translate-y-1/2 rounded-full bg-white/10 p-2 text-white hover:bg-white/25 md:right-6" aria-label="Siguiente">
      <Icon name="right" class="h-7 w-7" />
    </button>
  </dialog>
</div>

<style>
  .filter-btn {
    border-radius: 9999px;
    border: 1px solid rgb(0 0 0 / 0.12);
    padding: 0.6rem 1.4rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.3s;
  }
  .filter-btn:hover {
    border-color: var(--color-brand-500);
    color: var(--color-brand-500);
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--color-brand-500);
    border-color: var(--color-brand-500);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -10px var(--color-brand-500);
  }
  li.pop {
    animation: pop 0.6s var(--ease-out-expo);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
  }
  .lightbox[open] figure img,
  .lightbox[open] figure video {
    animation: pop 0.5s var(--ease-out-expo);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const anchors = () =>
      [...gallery.querySelectorAll<HTMLAnchorElement>('li:not([hidden]) a[data-index]')];
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    let current = 0;

    const video = dialog.querySelector<HTMLVideoElement>('[data-lb-video]')!;

    const show = (i: number) => {
      const list = anchors();
      current = (i + list.length) % list.length;
      const a = list[current];
      const isVideo = a.dataset.video !== undefined;
      video.pause();
      img.classList.toggle('hidden', isVideo);
      video.classList.toggle('hidden', !isVideo);
      if (isVideo) {
        img.removeAttribute('src');
        video.src = a.href;
        video.setAttribute('aria-label', a.dataset.alt ?? '');
        video.play().catch(() => {});
      } else {
        video.removeAttribute('src');
        img.src = a.href;
        img.alt = a.dataset.alt ?? '';
      }
      caption.textContent = a.dataset.caption ?? '';
    };

    // Vídeos de la cuadrícula: se reproducen (sin sonido) al pasar el ratón
    gallery.querySelectorAll<HTMLVideoElement>('[data-hover-video]').forEach((v) => {
      const a = v.closest('a')!;
      a.addEventListener('mouseenter', () => v.play().catch(() => {}));
      a.addEventListener('mouseleave', () => v.pause());
    });
    dialog.addEventListener('close', () => video.pause());

    gallery.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-index]');
      if (!a) return;
      e.preventDefault();
      show(anchors().indexOf(a));
      dialog.showModal();
    });
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).tagName === 'FIGURE') dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    const buttons = gallery.querySelectorAll<HTMLButtonElement>('[data-filter]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        gallery.querySelectorAll<HTMLElement>('li[data-category]').forEach((li) => {
          li.hidden = !!f && li.dataset.category !== f;
          if (!li.hidden) {
            li.classList.remove('pop');
            void li.offsetWidth; // reinicia la animación
            li.classList.add('pop');
          }
        });
      }),
    );
  }));
</script>

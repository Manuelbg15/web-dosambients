---
import SocialIcon from './SocialIcon.astro';
import { links } from '../data/links';
---

<a
  href={links.whatsapp.url}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="group fixed right-5 bottom-5 z-40 flex items-center gap-3 md:right-8 md:bottom-8"
  transition:persist
>
  <span
    class="pointer-events-none hidden translate-x-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-ink opacity-0 shadow-lg transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 md:block"
  >
    ¿Hablamos?
  </span>
  <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-xl shadow-black/20 transition-transform duration-300 group-hover:scale-110">
    <span class="absolute inset-0 animate-pulse-ring rounded-full bg-[#25d366]" aria-hidden="true"></span>
    <SocialIcon name="whatsapp" class="relative h-7 w-7" />
  </span>
</a>

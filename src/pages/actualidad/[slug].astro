---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { getNews, formatDate } from '../../data/news';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description} image={entry.data.image}>
  <PageHero
    title={entry.data.title}
    image={entry.data.image}
    crumbs={[{ label: 'Actualidad', href: '/actualidad/' }, { label: entry.data.title }]}
  />
  <article class="container-site max-w-3xl py-16">
    <time datetime={entry.data.date.toISOString()} class="text-sm font-semibold text-brand-500">
      {formatDate(entry.data.date)}
    </time>
    <div class="prose-site mt-4">
      <Content />
    </div>
    <a href="/actualidad/" class="mt-10 inline-flex items-center gap-2 font-semibold text-brand-500 hover:text-brand-700">
      <Icon name="left" class="h-4 w-4" /> Volver a Actualidad
    </a>
  </article>
</Layout>

# Página de error personalizada
ErrorDocument 404 /404.html

# Forzar HTTPS y www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.dosambients.es/$1 [L,R=301]

# Redirecciones desde las URLs de la web antigua
Redirect 301 /index.php /
Redirect 301 /quienessomos.php /quienes-somos/
Redirect 301 /catalogo.php /catalogo/
Redirect 301 /contacto.php /contacto/
Redirect 301 /facebook.php /actualidad/

# Caché de recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
